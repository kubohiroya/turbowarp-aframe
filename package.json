{
  "name": "@kubohiroya/turbowarp-aframe",
  "version": "0.14.2",
  "description": "A TurboWarp extension for declarative A-Frame scene graphs.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-aframe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-aframe.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-aframe/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "aframe",
    "3d",
    "ar",
    "scene-graph",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "schemas/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "lib-editor/",
    "schemas/",
    "docs/fixed-input-editors.ja.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && npm run build:editor",
    "lint": "eslint src tests vite.config.ts",
    "format": "eslint src tests vite.config.ts --fix",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "build:editor": "tsc -p tsconfig.editor.json",
    "prepare": "npm run build",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.8.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.12.0",
    "@pixiv/three-vrm": "3.6.0",
    "@types/node": "^24.13.3",
    "@types/three": "0.184.1",
    "eslint": "^9.39.5",
    "super-three": "0.184.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-extension-data-editor": "^0.11.5"
  },
  "exports": {
    "./*": "./*",
    "./editor-schema": {
      "types": "./lib-editor/src/editor-schema.d.ts",
      "import": "./lib-editor/src/editor-schema.js"
    }
  },
  "gitHead": "702b8b30cef5d3b27f1088a5fd436c5c5bfbdad8",
  "x-turbowarp-source": {
    "revision": "702b8b30cef5d3b27f1088a5fd436c5c5bfbdad8",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  },
  "turbowarpExtension": {
    "resourceDeclaration": {
      "schemaVersion": 1,
      "resources": [
        {
          "type": "network",
          "usage": "conditional",
          "purpose": {
            "en": "Load A-Frame and externally referenced 3D assets",
            "ja": "A-Frameと外部参照の3D素材を取得する"
          },
          "condition": {
            "en": "When A-Frame is not preloaded or a scene references external assets",
            "ja": "A-Frameが事前読込されていない場合、またはシーンが外部素材を参照する場合"
          },
          "data": {
            "direction": "download",
            "content": {
              "en": "A-Frame runtime, 3D/VRM models and image assets",
              "ja": "A-Frame実行ライブラリー、3D・VRMモデル、画像素材"
            }
          }
        }
      ]
    }
  }
}
