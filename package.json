{
  "name": "@kubohiroya/turbowarp-aframe",
  "version": "0.8.1",
  "description": "A TurboWarp extension for declarative A-Frame scene graphs.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-aframe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-aframe.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-aframe/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "aframe",
    "3d",
    "ar",
    "scene-graph",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "schemas/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "lib-editor/",
    "schemas/",
    "docs/fixed-input-editors.ja.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && npm run build:editor",
    "lint": "eslint src tests vite.config.ts",
    "format": "eslint src tests vite.config.ts --fix",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "build:editor": "tsc -p tsconfig.editor.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "0.3.2",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.6.1",
    "@pixiv/three-vrm": "3.5.5",
    "@types/node": "^24.13.3",
    "@types/three": "0.184.0",
    "eslint": "^9.39.5",
    "super-three": "0.184.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-extension-data-editor": "0.2.1"
  },
  "exports": {
    "./*": "./*",
    "./editor-schema": {
      "types": "./lib-editor/src/editor-schema.d.ts",
      "import": "./lib-editor/src/editor-schema.js"
    }
  },
  "gitHead": "1b4afdb67ae4d5237ba8e115e4b80b5fc28efff0",
  "x-turbowarp-source": {
    "revision": "1b4afdb67ae4d5237ba8e115e4b80b5fc28efff0",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
