{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kubohiroya/turbowarp-aframe/main/schemas/aframe-scene-yaml.schema.json",
  "title": "TurboWarp-A-Frame YAML Scene DSL",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "root"],
  "properties": {
    "formatVersion": {"const": 1},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layer": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1}
      }
    },
    "root": {"$ref": "aframe-template.schema.json"}
  }
}
