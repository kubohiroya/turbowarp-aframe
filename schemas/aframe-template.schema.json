{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kubohiroya/turbowarp-aframe/main/schemas/aframe-template.schema.json",
  "title": "TurboWarp-A-Frame Template Node",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "class": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      ]
    },
    "classes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "data": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "attributes": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "children": {
      "type": "array",
      "items": {"$ref": "#"}
    }
  }
}
